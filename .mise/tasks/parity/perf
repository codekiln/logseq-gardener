#!/usr/bin/env bash
#MISE description="Measure load time, data, script, memory and search latency for both builds"
#USAGE flag "--run <path>" help="Run directory from parity:build and parity:compare (default: the latest)"
#USAGE flag "--fixtures <path>" help="Fixture list, one page title per line"
#USAGE flag "--profiles <list>" help="Comma-separated profiles: desktop, phone (default: both)"
#USAGE flag "--loads <count>" help="Loads per page, build and profile (default: 3)"
#USAGE flag "--builds <list>" help="Comma-separated builds to measure: logseq, lsg (default: both); others keep this run's rows"
#USAGE flag "--record" help="Rewrite docs/parity/performance.md with the results"
set -euo pipefail
args=()
if [ -n "${usage_run:-}" ]; then args+=(--run "$usage_run"); fi
if [ -n "${usage_fixtures:-}" ]; then args+=(--fixtures "$usage_fixtures"); fi
if [ -n "${usage_profiles:-}" ]; then args+=(--profiles "$usage_profiles"); fi
if [ -n "${usage_loads:-}" ]; then args+=(--loads "$usage_loads"); fi
if [ -n "${usage_builds:-}" ]; then args+=(--builds "$usage_builds"); fi
if [ "${usage_record:-false}" = "true" ]; then args+=(--record); fi
echo "Checking Playwright's Chromium (downloaded on first use)"
uv run --quiet --with playwright==1.60.0 --no-project playwright install chromium-headless-shell
uv run --quiet --script scripts/parity/perf.py ${args[@]+"${args[@]}"}
