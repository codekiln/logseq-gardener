#!/usr/bin/env bash
#MISE description="Measure load time, data, script, memory and search latency for both builds"
#USAGE flag "--run <path>" help="Run directory from parity:build and parity:compare (default: the latest)"
#USAGE flag "--fixtures <path>" help="Fixture list, one page title per line"
#USAGE flag "--profiles <list>" help="Comma-separated profiles: desktop, phone (default: both)"
#USAGE flag "--loads <count>" help="Loads per page, build and profile (default: 3)"
#USAGE flag "--builds <list>" help="Comma-separated builds to measure: logseq, lsg (default: both); others keep this run's rows"
#USAGE flag "--search-site <path>" help="Measure search only, in a built site; a parity run site also measures Logseq beside it and build time"
#USAGE flag "--search-path <path>" help="Page path inside search-site (default: index.html)"
#USAGE flag "--search-output <path>" help="JSON output for standalone search measurements"
#USAGE flag "--search-queries <path>" help="Search query fixture list"
#USAGE flag "--record" help="Rewrite docs/parity/performance.md with the results (with --search-site, its search sections)"
#USAGE flag "--graph" help="Measure only the graph view and Page graph in the run's site (with --record, their sections)"
#USAGE flag "--slides" help="Measure only View as slides in the run's site (with --record, its section)"
#USAGE flag "--media" help="Measure only the video pages in the run's site (with --record, their section)"
#USAGE flag "--baseline-lsg <path>" help="Also time a whole-garden build with this lsg binary, such as one built before a feature"
set -euo pipefail
args=()
if [ -n "${usage_run:-}" ]; then args+=(--run "$usage_run"); fi
if [ -n "${usage_fixtures:-}" ]; then args+=(--fixtures "$usage_fixtures"); fi
if [ -n "${usage_profiles:-}" ]; then args+=(--profiles "$usage_profiles"); fi
if [ -n "${usage_loads:-}" ]; then args+=(--loads "$usage_loads"); fi
if [ -n "${usage_builds:-}" ]; then args+=(--builds "$usage_builds"); fi
if [ -n "${usage_search_site:-}" ]; then args+=(--search-site "$usage_search_site"); fi
if [ -n "${usage_search_path:-}" ]; then args+=(--search-path "$usage_search_path"); fi
if [ -n "${usage_search_output:-}" ]; then args+=(--search-output "$usage_search_output"); fi
if [ -n "${usage_search_queries:-}" ]; then args+=(--search-queries "$usage_search_queries"); fi
if [ "${usage_record:-false}" = "true" ]; then args+=(--record); fi
if [ "${usage_graph:-false}" = "true" ]; then args+=(--graph); fi
if [ "${usage_slides:-false}" = "true" ]; then args+=(--slides); fi
if [ "${usage_media:-false}" = "true" ]; then args+=(--media); fi
if [ -n "${usage_baseline_lsg:-}" ]; then args+=(--baseline-lsg "$usage_baseline_lsg"); fi
echo "Checking Playwright's Chromium (downloaded on first use)"
uv run --quiet --with playwright==1.60.0 --no-project playwright install chromium-headless-shell
uv run --quiet --script scripts/parity/perf.py ${args[@]+"${args[@]}"}
