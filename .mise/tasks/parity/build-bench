#!/usr/bin/env bash
#MISE description="Measure build plugins on a whole garden against the [build_plugins] budgets"
#USAGE flag "--garden <path>" help="Garden to publish (default: the encode garden from ghq)"
#USAGE flag "--runs <count>" help="Builds per variant; the fastest counts (default: 3)"
#USAGE flag "--output <path>" help="Write the measurements as JSON to this file"
set -euo pipefail
args=()
if [ -n "${usage_garden:-}" ]; then args+=(--garden "$usage_garden"); fi
if [ -n "${usage_runs:-}" ]; then args+=(--runs "$usage_runs"); fi
if [ -n "${usage_output:-}" ]; then args+=(--output "$usage_output"); fi
python3 scripts/parity/build_bench.py ${args[@]+"${args[@]}"}
