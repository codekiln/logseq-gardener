#!/usr/bin/env bash
#MISE description="Load the docs graph with Logseq's own file parser and with the SDK, and fail where they disagree"
#USAGE flag "-h --help" help="Show task help"
set -euo pipefail
# The check must still fail on its fixture, a block that writes a reference and a property name that differ in case, which Logseq and the SDK spell differently (issue #521).
python3 -m unittest discover -s scripts/logseq-parser -p 'test_*.py'
python3 scripts/logseq-parser/check.py docs
