#!/usr/bin/env bash
#MISE description="Build the docs site with no lsg diagnostics, run every README command and check the docs graph and the remaining Markdown files"
#USAGE flag "-h --help" help="Show task help"
set -euo pipefail
tmp="${TMPDIR:-/tmp}"
site_root="$(mktemp -d "${tmp%/}/lsg-docs-check.XXXXXX")"
mise run docs:site --output "$site_root/site"
python3 scripts/docs.py
rm -rf "$site_root"
