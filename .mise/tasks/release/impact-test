#!/usr/bin/env bash
#MISE description="Test release-plz SemVer impact before and after 1.0"
#USAGE flag "-h --help" help="Show task help"
set -euo pipefail

root=$(git rev-parse --show-toplevel)
fixture="$root/tests/fixtures/release-impact"
tmp_root=$(mktemp -d)
trap 'rm -rf "$tmp_root"' EXIT
case_index=0
# In place of a changed file, this value makes a case add the language server package after the release tag.
new_package="new package"

run_case() {
  local current=$1
  local title=$2
  local expected=$3
  local config=$4
  local changed_file=${5:-src/main.rs}
  local case_dir="$tmp_root/case-$case_index"
  case_index=$((case_index + 1))

  cp -R "$fixture" "$case_dir"
  sed -i.bak "s/version = \"0.0.0\"/version = \"$current\"/" "$case_dir/Cargo.toml"
  rm "$case_dir/Cargo.toml.bak"
  for member in sdk lsp; do
    sed -i.bak "s/version = \"0.0.0\"/version = \"$current\"/" "$case_dir/$member/Cargo.toml"
    rm "$case_dir/$member/Cargo.toml.bak"
  done

  (
    cd "$case_dir"
    git init -q
    git config user.name "Release Impact Test"
    git config user.email "release-impact@example.invalid"
    git remote add origin https://github.com/codekiln/logseq-gardener
    if [[ "$changed_file" == "$new_package" ]]; then
      # Release the fixture without the language server package, then add the package.
      cp Cargo.toml "$case_dir.Cargo.toml"
      mv lsp "$case_dir.lsp"
      sed -i.bak -e 's/members = \["sdk", "lsp"\]/members = ["sdk"]/' -e '/^logseq-gardener-lsp = /d' Cargo.toml
      rm Cargo.toml.bak
    fi
    cargo generate-lockfile --offline
    git add .
    git commit -qm "initial fixture"
    git tag "v$current"

    if [[ "$changed_file" == "$new_package" ]]; then
      mv "$case_dir.Cargo.toml" Cargo.toml
      mv "$case_dir.lsp" lsp
      cargo generate-lockfile --offline
      git add .
    else
      sed -i.bak 's/MARKER: u8 = 0/MARKER: u8 = 1/' "$changed_file"
      rm "$changed_file.bak"
      git add "$changed_file"
    fi
    git commit -qm "$title"

    # Prepare the release with the config that release:prepare gives release-plz.
    # mise finds no tasks from the temporary repository, so the task file runs directly.
    usage_config="$root/$config" usage_output="$case_dir.release-plz.toml" "$root/.mise/tasks/release/prepare-config"
    release-plz update --config "$case_dir.release-plz.toml" --repo-url https://github.com/codekiln/logseq-gardener
  )

  local actual
  actual=$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$case_dir/Cargo.toml" | head -n 1)
  if [[ "$actual" != "$expected" ]]; then
    printf 'expected %s -> %s for %s, got %s\n' "$current" "$expected" "$title" "$actual" >&2
    return 1
  fi
  # The SDK and the language server take the CLI's version.
  local member member_version
  for member in sdk lsp; do
    member_version=$(sed -n 's/^version = "\([^" ]*\)"/\1/p' "$case_dir/$member/Cargo.toml")
    if [[ "$member_version" != "$expected" ]]; then
      printf '%s expected %s, got %s\n' "$member" "$expected" "$member_version" >&2
      return 1
    fi
  done
  cargo metadata --locked --offline --format-version 1 --manifest-path "$case_dir/Cargo.toml" >/dev/null
}

run_case 0.2.3 "✨ feat: add capability" 0.2.4 release-plz.toml
run_case 0.2.3 "🩹 fix: correct behavior" 0.2.4 release-plz.toml
run_case 0.2.3 "✨ feat!: replace behavior" 0.3.0 release-plz.toml
run_case 0.2.3 "📝 docs: clarify usage" 0.2.3 release-plz.toml
run_case 1.2.3 "✨ feat: add capability" 1.3.0 release-plz-post-1.toml
run_case 1.2.3 "🩹 fix: correct behavior" 1.2.4 release-plz-post-1.toml
run_case 1.2.3 "✨ feat!: replace behavior" 2.0.0 release-plz-post-1.toml
run_case 1.2.3 "📝 docs: clarify usage" 1.2.3 release-plz-post-1.toml

run_case 0.2.3 "✨ feat: add SDK capability" 0.2.4 release-plz.toml sdk/src/lib.rs
run_case 1.2.3 "✨ feat: add SDK capability" 1.3.0 release-plz-post-1.toml sdk/src/lib.rs

run_case 0.2.3 "✨ feat: add language server capability" 0.2.4 release-plz.toml lsp/src/lib.rs
run_case 1.2.3 "✨ feat: add language server capability" 1.3.0 release-plz-post-1.toml lsp/src/lib.rs

# release-plz stops when a package is missing from the latest release tag unless
# release:prepare-config marks the package as a first release.
run_case 0.2.3 "✨ feat: add the language server" 0.2.4 release-plz.toml "$new_package"
run_case 1.2.3 "✨ feat: add the language server" 1.3.0 release-plz-post-1.toml "$new_package"
run_case 0.2.3 "📝 docs: describe the language server" 0.2.3 release-plz.toml "$new_package"

printf 'release impact tests passed\n'
